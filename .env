# Configuration Firebase du client web. Rien de secret : ces valeurs sont de
# toute façon visibles dans le JS envoyé au navigateur. La sécurité repose sur
# les règles Firestore et les restrictions des clés API (console Google Cloud).
#
# Ce fichier est chargé dans tous les modes ; `.env.production` surcharge la
# clé pour le build de production.
VITE_FIREBASE_AUTH_DOMAIN=wrap-it-up-2d42a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wrap-it-up-2d42a
VITE_FIREBASE_STORAGE_BUCKET=wrap-it-up-2d42a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=403789903986
VITE_FIREBASE_APP_ID=1:403789903986:web:154aa29c98d960ea87eaeb

# Clé de site reCAPTCHA Enterprise utilisée par App Check (publique). Seuls
# les domaines de production y sont autorisés : en dev et sur les previews,
# App Check passe en mode debug (voir src/firebaseLoader.ts).
VITE_RECAPTCHA_SITE_KEY=6LehEh0uAAAAADe3aZEmrKjlbuk1JzkfpBBA5iG5

# Clé « Dev / previews » : restreinte aux API Identity Toolkit, Token Service
# et Cloud Firestore, sans restriction de site (localhost et canaux de preview
# des PR, dont le domaine change à chaque PR).
VITE_FIREBASE_API_KEY=AIzaSyDQghkPtxRZObaN9jShP0BI2tZV5vzWN2w

{
  "name": "wrap-it-up",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint --deny-warnings src",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:rules": "firebase emulators:exec --only firestore --project demo-wrap-it-up \"node --test tests/*.test.ts\""
  },
  "dependencies": {
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.35.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

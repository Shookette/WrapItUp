{
  "name": "wrap-it-up",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#hooks/*": "./src/hooks/*",
    "#interfaces/*": "./src/interfaces/*",
    "#repository/*": "./src/repository/*",
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint --deny-warnings src",
    "preview": "vite preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "firebase": "^11.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "~1.168.48",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
